APP_NAME="Madrasatul Fathi School"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=https://api.madrassatalfath.com
FRONTEND_URL=https://madrassatalfath.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace-with-your-cpanel-database-name
DB_USERNAME=replace-with-your-cpanel-database-user
DB_PASSWORD=replace-with-your-cpanel-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.madrassatalfath.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=madrassatalfath.com,www.madrassatalfath.com
SANCTUM_EXPIRATION=60
CORS_ALLOWED_ORIGINS=https://madrassatalfath.com,https://www.madrassatalfath.com

CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=mail.madrassatalfath.com
MAIL_PORT=587
