Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^api\.madrassatalfath\.com(:[0-9]+)?$ [NC]
    RewriteRule ^ - [F,L]
    RewriteRule ^public/ - [L]
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
